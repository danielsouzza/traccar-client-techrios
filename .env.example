# Modelo de configuracao. Copie para .env e preencha as chaves.
# Uso: flutter run --dart-define-from-file=.env
#
# Sao constantes de compilacao: alterar aqui exige rebuild, hot reload nao pega.

# --- Homologacao ---
# Enquanto a API nao estiver publicada, aponta para o Laravel local servido
# pelo Traefik no WSL. O emulador alcanca a maquina hospedeira por 10.0.2.2,
# e o Host precisa ir no header porque o Traefik roteia por ele.
RASTREIO_BASE_URL_HOMOLOG=https://app.homologacao.techrios.online
RASTREIO_HOST_HEADER_HOMOLOG=
RASTREIO_API_KEY_HOMOLOG=

# --- Producao ---
# --- Developer (pre-producao) ---
RASTREIO_BASE_URL_DEV=https://app.developer.techrios.online
RASTREIO_HOST_HEADER_DEV=
RASTREIO_API_KEY_DEV=

RASTREIO_BASE_URL_PROD=https://app.techrios.online
RASTREIO_HOST_HEADER_PROD=
RASTREIO_API_KEY_PROD=

# Trava o ambiente e esconde o seletor no login.
# Vazio = seletor visivel (desenvolvimento). Build publico: producao
RASTREIO_ENV=
